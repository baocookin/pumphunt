# Copy to .env. Bot settings are prefixed PH_ (see bot/app/config.py).

# Host port for docker compose (change if 8080 is already in use on your machine)
PORT=8080

# Primary feed: Solana RPC websocket. Get a free Helius key (helius.dev):
#   wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# The public endpoint works for the default "migrations" scope but may drop the connection.
PH_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
PH_CHAIN_COMMITMENT=confirmed
# HTTP RPC for getTransaction (derived from the websocket URL when empty)
# PH_SOLANA_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Confirm each PumpPortal migration on-chain by signature (1 credit each, ~1k/day)
PH_RPC_CONFIRM=true
# Poll getSignaturesForAddress(authority) as the primary migration source; walk back PH_BACKFILL_S on a cold start.
PH_RPC_POLL=true
PH_POLL_S=30
PH_BACKFILL_S=21600
# Global RPC pace (req/s) and back-off after a 429; Helius free tier allows ~10/s.
PH_RPC_RPS=5
PH_RPC_429_PENALTY_S=2
# migrations = only graduation transactions (a few MB/day, fits Helius free tier)
# full       = every pump.fun create/trade too (5-15 GB/day of stream: paid RPC + big volume)
PH_CHAIN_SCOPE=migrations

# Secondary feed: coverage counts + migration fallback (free channels, no key needed)
PH_PUMPPORTAL_ENABLED=true
PH_PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Harvester (GeckoTerminal public API, free, ~30 req/min)
# Public GeckoTerminal API: no key, ~30 req/min nominal (measured 5-7/min in practice; the limiter adapts).
# With a CoinGecko plan: PH_GECKO_BASE_URL=https://pro-api.coingecko.com/api/v3/onchain  PH_GECKO_API_KEY=...  PH_GECKO_RPM=250
PH_GECKO_RPM=20
PH_HARVEST_AFTER_S=90000

# Hypothesis C pricing
PH_COST_BPS_ROUND_TRIP=350

# Executable fills on PumpSwap reserves (RPC credits; Helius getTransactionsForAddress strongly preferred)
PH_FILLS_ENABLED=true
# Cells replayed swap by swap with our order in the pool (the primary estimate)
PH_FILLS_REPLAY_CELLS=["d30_h60","d60_h60"]
# Caps in transactions, not swaps: on busy pools ~95% are MEV bots that read the price and trade nothing
PH_FILLS_REPLAY_MAX_TX=15000
PH_FILLS_FLOW_MAX_TX=3000
PH_FILLS_SCAN_PAGES=3
# Try Helius' tokenTransfer filter to drop non-trades; used only after side-by-side checks pass
PH_FILLS_TOKEN_FILTER=true
PH_FILLS_DAILY_CREDITS=270000
PH_FILL_SIZES_SOL=[0.5,1,2,5]
