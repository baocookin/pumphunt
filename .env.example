# Copy to .env. Bot settings are prefixed PH_ (see bot/app/config.py).

# Host ports for docker compose (change if 8080 / 3000 are already in use on your machine)
BOT_PORT=8080
WEB_PORT=3000

# Primary feed: Solana RPC websocket. Public endpoint works but rate-limits and drops;
# get a free Helius key (helius.dev) and use: wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
PH_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
PH_CHAIN_COMMITMENT=confirmed

# Secondary feed for coverage measurement (free channels, no key needed)
PH_PUMPPORTAL_ENABLED=true
PH_PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Harvester (GeckoTerminal public API, free, ~30 req/min)
PH_GECKO_RPM=25
PH_HARVEST_AFTER_S=90000

# Hypothesis C pricing
PH_COST_BPS_ROUND_TRIP=350
